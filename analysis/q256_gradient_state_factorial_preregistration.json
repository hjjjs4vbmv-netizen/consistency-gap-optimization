  "tolerance_rationale": {
    "exact_scalar_reset_actual_vs_idealized_RAdam_atol": "Frozen at 1e-3 from the repository's pre-existing float32 RAdam-vs-float64 analytical predictor regression test. RAdam eps=1e-8 can create a real non-zero D-cell R_opt even for exactly scalar gradients, so correctness is actual-vs-predicted plus H=R_opt, not an invalid R_opt=0 assertion.",
    "formal_result_tuning": false
  },
  "operations_excluded": [
    "training",
    "sample_generation",
    "FID",
    "KID",
    "continuation_training",
    "moment_only_variants"
  ],
  "interpretation_order": [
    "D",
    "C",
    "B_minus_D",
    "A_minus_C",
    "A_minus_B"
  ],
  "interpretation_boundary": "The four cells are a diagnostic factorial and not an additive causal decomposition. Audit batches are repeated measurements within three training-seed replicates."
